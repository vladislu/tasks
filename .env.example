# Copy to .env.local to point the app at a backend.
#
# When empty (the default), boards are stored in the browser's localStorage and
# the app works fully offline — that is the mode GitHub Pages runs in.
#
# When set, the app reads and writes boards through the REST contract described
# in docs/database.md. The value is the API root, without a trailing slash.
VITE_API_BASE_URL=

# Optional bearer token sent as `Authorization: Bearer <token>` by the REST
# adapter. Only use this for local experiments: anything in a VITE_ variable is
# compiled into the public bundle.
VITE_API_TOKEN=
